{
  "audio": {
    "src": "https://pub-13abeb101e2945d2a7f60234f6faf52e.r2.dev/materials/a1-grammar-build-a-sentence/audio/main-f4a49ab599df.mp3",
    "durationSec": 161.976,
    "cues": [
      {
        "start": 0,
        "end": 1.16,
        "text": "You meet someone at school."
      },
      {
        "start": 1.16,
        "end": 3.64,
        "text": "Be tells us who or where someone is."
      },
      {
        "start": 3.98,
        "end": 5.62,
        "text": "It also tells us how someone feels."
      },
      {
        "start": 6.46,
        "end": 7.32,
        "text": "Use am with I."
      },
      {
        "start": 7.68,
        "end": 9.18,
        "text": "Use is with he, she and it."
      },
      {
        "start": 9.54,
        "end": 11.08,
        "text": "Use are with you, we and they."
      },
      {
        "start": 11.6,
        "end": 12.18,
        "text": "I am a student."
      },
      {
        "start": 12.96,
        "end": 13.64,
        "text": "Emma is a teacher."
      },
      {
        "start": 14.04,
        "end": 14.86,
        "text": "She is a teacher."
      },
      {
        "start": 15.44,
        "end": 15.94,
        "text": "Ben is here."
      },
      {
        "start": 16.24,
        "end": 16.82,
        "text": "He is here."
      },
      {
        "start": 17.26,
        "end": 17.94,
        "text": "We are at school."
      },
      {
        "start": 18.1,
        "end": 18.56,
        "text": "It is sunny."
      },
      {
        "start": 19.08,
        "end": 19.78,
        "text": "Use it for the weather."
      },
      {
        "start": 20.58,
        "end": 23.24,
        "text": "For questions, put am, is or are first."
      },
      {
        "start": 24.02,
        "end": 24.46,
        "text": "You are ready."
      },
      {
        "start": 24.96,
        "end": 25.4,
        "text": "Are you ready?"
      },
      {
        "start": 26.04,
        "end": 27.08,
        "text": "Yes, I am."
      },
      {
        "start": 27.54,
        "end": 28.52,
        "text": "No, I am not."
      },
      {
        "start": 28.52,
        "end": 30.92,
        "text": "Answer with I when someone asks about you."
      },
      {
        "start": 31.08,
        "end": 32.4,
        "text": "To say no, add not after be."
      },
      {
        "start": 32.86,
        "end": 33.7,
        "text": "I am not ready."
      },
      {
        "start": 34.32,
        "end": 34.86,
        "text": "Where is Emma?"
      },
      {
        "start": 35.32,
        "end": 36.1,
        "text": "She is at school."
      },
      {
        "start": 36.1,
        "end": 38.76,
        "text": "Short forms:\n\nI'm = I am."
      },
      {
        "start": 39.22,
        "end": 40.26,
        "text": "Isn't = is not."
      },
      {
        "start": 40.76,
        "end": 41.68,
        "text": "Aren't = are not."
      },
      {
        "start": 42.08,
        "end": 43.78,
        "text": "Keep am in Yes, I am."
      },
      {
        "start": 44.54,
        "end": 45.46,
        "text": "Wrong: Do you are ready?"
      },
      {
        "start": 45.46,
        "end": 47.04,
        "text": "Write Are you ready?"
      },
      {
        "start": 47.42,
        "end": 48.14,
        "text": "Put be first."
      },
      {
        "start": 48.14,
        "end": 50.72,
        "text": "Study: Read these two sentences."
      },
      {
        "start": 51.34,
        "end": 51.84,
        "text": "You are ready."
      },
      {
        "start": 52.22,
        "end": 52.76,
        "text": "Are you ready?"
      },
      {
        "start": 53.4,
        "end": 54.5,
        "text": "Which words change places?"
      },
      {
        "start": 55.26,
        "end": 56.56,
        "text": "A statement tells us something."
      },
      {
        "start": 57.18,
        "end": 58.06,
        "text": "Start with who or what."
      },
      {
        "start": 58.06,
        "end": 59.2,
        "text": "Then put its verb."
      },
      {
        "start": 59.2,
        "end": 61.12,
        "text": "Add other words if you need them."
      },
      {
        "start": 61.12,
        "end": 62.72,
        "text": "Read and be are verbs."
      },
      {
        "start": 62.72,
        "end": 63.76,
        "text": "We read."
      },
      {
        "start": 64.04,
        "end": 64.74,
        "text": "They play football."
      },
      {
        "start": 65.06,
        "end": 65.68,
        "text": "He is happy."
      },
      {
        "start": 66.12,
        "end": 66.84,
        "text": "The bag is here."
      },
      {
        "start": 67.16,
        "end": 68.2,
        "text": "We can stop after read."
      },
      {
        "start": 68.76,
        "end": 69.46,
        "text": "The bag is here."
      },
      {
        "start": 69.94,
        "end": 70.68,
        "text": "Is the bag here?"
      },
      {
        "start": 71.2,
        "end": 71.92,
        "text": "Where is the bag?"
      },
      {
        "start": 72.62,
        "end": 73.8,
        "text": "Where asks about a place."
      },
      {
        "start": 74.34,
        "end": 75.96,
        "text": "Put this question word before is."
      },
      {
        "start": 76.72,
        "end": 78.2,
        "text": "Wrong: Is here the bag."
      },
      {
        "start": 78.2,
        "end": 79.62,
        "text": "Write The bag is here."
      },
      {
        "start": 80.22,
        "end": 82.52,
        "text": "Study: Read the statement and its two questions."
      },
      {
        "start": 83.2,
        "end": 84.14,
        "text": "Find the bag in each."
      },
      {
        "start": 84.88,
        "end": 86.94,
        "text": "Be tells who, where or how."
      },
      {
        "start": 87.64,
        "end": 89.98,
        "text": "An action verb tells what someone does."
      },
      {
        "start": 90.22,
        "end": 90.62,
        "text": "I am ready."
      },
      {
        "start": 90.78,
        "end": 91.64,
        "text": "I walk to school."
      },
      {
        "start": 92.16,
        "end": 92.66,
        "text": "We are happy."
      },
      {
        "start": 92.92,
        "end": 93.62,
        "text": "We play football."
      },
      {
        "start": 93.94,
        "end": 94.9,
        "text": "I read books at home."
      },
      {
        "start": 95.66,
        "end": 97.34,
        "text": "Walk, play and read show actions."
      },
      {
        "start": 97.88,
        "end": 100,
        "text": "Use be or an action verb in these sentences."
      },
      {
        "start": 100.94,
        "end": 102.52,
        "text": "Wrong: I am go to school."
      },
      {
        "start": 102.52,
        "end": 104.2,
        "text": "Write I go to school."
      },
      {
        "start": 104.88,
        "end": 105.82,
        "text": "Go is the verb here."
      },
      {
        "start": 106.34,
        "end": 107.88,
        "text": "Do not add am before go."
      },
      {
        "start": 107.88,
        "end": 110.8,
        "text": "Study: Read I am ready and I walk."
      },
      {
        "start": 111.6,
        "end": 112.78,
        "text": "Which sentence has an action?"
      },
      {
        "start": 113.32,
        "end": 115.4,
        "text": "A capital letter is a big letter, like A."
      },
      {
        "start": 115.4,
        "end": 117.86,
        "text": "Use a big letter to start each sentence."
      },
      {
        "start": 118.58,
        "end": 119.52,
        "text": "Always write a big I."
      },
      {
        "start": 119.52,
        "end": 122.02,
        "text": "Names start with big letters too."
      },
      {
        "start": 123.16,
        "end": 123.96,
        "text": "I am Ben."
      },
      {
        "start": 125.78,
        "end": 126.52,
        "text": "Emma is here."
      },
      {
        "start": 129.47,
        "end": 130.31,
        "text": "We read books."
      },
      {
        "start": 131.05,
        "end": 131.49,
        "text": "Are you ready?"
      },
      {
        "start": 133.17,
        "end": 134.73,
        "text": "End a statement with a full stop."
      },
      {
        "start": 135.99,
        "end": 137.75,
        "text": "End a question with a question mark."
      },
      {
        "start": 139.37,
        "end": 144.85,
        "text": "Wrong: i am ben\n\nWrite I am Ben."
      },
      {
        "start": 149.13,
        "end": 151.63,
        "text": "Study: Read these two sentences."
      },
      {
        "start": 153.25,
        "end": 154.01,
        "text": "Emma is here."
      },
      {
        "start": 155.63,
        "end": 156.53,
        "text": "Is Emma here?"
      },
      {
        "start": 158.27,
        "end": 161.51,
        "text": "Find each big letter, full stop and question mark."
      }
