    {
      "kind": "text",
      "id": "blk_part_02_questions_and_negatives_with_do",
      "title": "Part 2: Questions and Negatives with Do",
      "role": "part",
      "paragraphs": [
        "For questions, put do before I, you, we, or they.",
        "Then add read, eat, walk, or play.",
        "For no, put do not before read or play.",
        "You read at home.",
        "Do you read at home?",
        "Yes, I do. / No, I do not.",
        "I do not read at home.",
        "You changes to I when you give your answer.",
        "Do they walk to school?",
        "Yes, they do. / No, they do not.",
        "Short answers use do.",
        "Do not add read or walk after do.",
        "Put what, where, or when before do.",
        "What do you read? Books.",
        "Where do you read? At home.",
        "When do you read? After school.",
        "What asks about things; where asks about places.",
        "When asks about time.",
        "Are you ready? uses be, so leave out do."
      ],
      "images": [
        {
          "src": "https://pub-13abeb101e2945d2a7f60234f6faf52e.r2.dev/materials/a1-grammar-everyday-actions/images/picture-2-9684aefe7752.webp",
          "alt": "Warm illustration of two children talking beside an open picture book, one asking and one answering, no letters, numbers, words, or symbols",
          "afterParagraph": 0
        }
      ],
      "audio": true
    },
