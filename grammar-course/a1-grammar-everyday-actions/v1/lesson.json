    {
      "kind": "text",
      "id": "blk_part_01_everyday_actions",
      "title": "Part 1: Everyday Actions",
      "role": "part",
      "paragraphs": [
        "Use the present simple for things you do often.",
        "Put I, you, we, or they before read or play.",
        "Read stays the same with these four words.",
        "I read every day.",
        "You eat breakfast every day.",
        "We walk to school on Mondays.",
        "They play at home after school.",
        "Read is an ordinary verb: it tells us an action.",
        "Ready tells us how someone is.",
        "I read. I am ready.",
        "Use am with ready.",
        "Say I read, not I am read.",
        "Say one true sentence about your day."
      ],
      "images": [
        {
          "src": "https://pub-13abeb101e2945d2a7f60234f6faf52e.r2.dev/materials/a1-grammar-everyday-actions/images/picture-1-34881ea96840.webp",
          "alt": "Warm illustration of two children walking toward a school building, no letters, numbers, words, or symbols",
          "afterParagraph": 0
        }
      ],
      "audio": true
    },
