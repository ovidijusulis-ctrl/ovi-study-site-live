{
  "audio": {
    "src": "https://pub-13abeb101e2945d2a7f60234f6faf52e.r2.dev/materials/a1-grammar-everyday-actions/audio/main-adcd3f3a7a3b.mp3",
    "durationSec": 114.408,
    "cues": [
      {
        "start": 0,
        "end": 2.28,
        "text": "Use the present simple for things you do often."
      },
      {
        "start": 2.82,
        "end": 6.3,
        "text": "Put I, you, we, or they before read or play."
      },
      {
        "start": 6.3,
        "end": 8.82,
        "text": "Read stays the same with these four words."
      },
      {
        "start": 9.44,
        "end": 10.32,
        "text": "I read every day."
      },
      {
        "start": 10.74,
        "end": 12,
        "text": "You eat breakfast every day."
      },
      {
        "start": 12.48,
        "end": 13.8,
        "text": "We walk to school on Mondays."
      },
      {
        "start": 14.16,
        "end": 15.5,
        "text": "They play at home after school."
      },
      {
        "start": 16.38,
        "end": 18.62,
        "text": "Read is an ordinary verb: it tells us an action."
      },
      {
        "start": 19.32,
        "end": 20.8,
        "text": "Ready tells us how someone is."
      },
      {
        "start": 21.46,
        "end": 21.94,
        "text": "I read."
      },
      {
        "start": 22.42,
        "end": 22.86,
        "text": "I am ready."
      },
      {
        "start": 23.4,
        "end": 24.48,
        "text": "Use am with ready."
      },
      {
        "start": 25.04,
        "end": 27.18,
        "text": "Say I read, not I am read."
      },
      {
        "start": 27.78,
        "end": 29.68,
        "text": "Say one true sentence about your day."
      },
      {
        "start": 30.14,
        "end": 33.64,
        "text": "For questions, put do before I, you, we, or they."
      },
      {
        "start": 34.2,
        "end": 36.76,
        "text": "Then add read, eat, walk, or play."
      },
      {
        "start": 37.36,
        "end": 39.98,
        "text": "For no, put do not before read or play."
      },
      {
        "start": 40.44,
        "end": 41.14,
        "text": "You read at home."
      },
      {
        "start": 41.56,
        "end": 42.36,
        "text": "Do you read at home?"
      },
      {
        "start": 42.72,
        "end": 43.34,
        "text": "Yes, I do."
      },
      {
        "start": 43.34,
        "end": 44.48,
        "text": "/ No, I do not."
      },
      {
        "start": 44.68,
        "end": 45.8,
        "text": "I do not read at home."
      },
      {
        "start": 46.34,
        "end": 48.14,
        "text": "You changes to I when you give your answer."
      },
      {
        "start": 48.6,
        "end": 49.42,
        "text": "Do they walk to school?"
      },
      {
        "start": 49.76,
        "end": 50.44,
        "text": "Yes, they do."
      },
      {
        "start": 50.44,
        "end": 51.62,
        "text": "/ No, they do not."
      },
      {
        "start": 52.3,
        "end": 53.26,
        "text": "Short answers use do."
      },
      {
        "start": 53.78,
        "end": 56.02,
        "text": "Do not add read or walk after do."
      },
      {
        "start": 56.02,
        "end": 60.44,
        "text": "Put what, where, or when before do."
      },
      {
        "start": 61.28,
        "end": 62.32,
        "text": "What do you read?"
      },
      {
        "start": 62.82,
        "end": 62.98,
        "text": "Books."
      },
      {
        "start": 63.7,
        "end": 64.34,
        "text": "Where do you read?"
      },
      {
        "start": 64.74,
        "end": 65.22,
        "text": "At home."
      },
      {
        "start": 65.84,
        "end": 66.48,
        "text": "When do you read?"
      },
      {
        "start": 66.92,
        "end": 67.48,
        "text": "After school."
      },
      {
        "start": 68.48,
        "end": 72.5,
        "text": "What asks about things; where asks about places."
      },
      {
        "start": 73.22,
        "end": 74.64,
        "text": "When asks about time."
      },
      {
        "start": 75.64,
        "end": 76.16,
        "text": "Are you ready?"
      },
      {
        "start": 76.68,
        "end": 78.48,
        "text": "uses be, so leave out do."
      },
      {
        "start": 79.22,
        "end": 82.14,
        "text": "Don't and do not mean the same thing."
      },
      {
        "start": 83.06,
        "end": 87.64,
        "text": "Put either before read, eat, walk, or play."
      },
      {
        "start": 88.5,
        "end": 89.98,
        "text": "I do not play after school."
      },
      {
        "start": 90.72,
        "end": 92.2,
        "text": "I don't play after school."
      },
      {
        "start": 92.82,
        "end": 93.92,
        "text": "You don't read at home."
      },
      {
        "start": 94.08,
        "end": 94.92,
        "text": "We don't walk to school."
      },
      {
        "start": 95.42,
        "end": 97.06,
        "text": "They don't eat breakfast at home."
      },
      {
        "start": 98.18,
        "end": 101.86,
        "text": "In don't, the letter o from not is not there."
      },
      {
        "start": 102.96,
        "end": 104.5,
        "text": "An apostrophe shows this."
      },
      {
        "start": 105.12,
        "end": 106.94,
        "text": "Put the apostrophe before t."
      },
      {
        "start": 107.76,
        "end": 109.76,
        "text": "Write don't as one word."
      },
      {
        "start": 110.54,
        "end": 113.92,
        "text": "Dont is wrong: there is no apostrophe."
      }
    ],
