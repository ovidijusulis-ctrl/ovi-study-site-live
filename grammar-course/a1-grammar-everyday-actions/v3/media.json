    "cues": [
      {
        "start": 0,
        "end": 2.24,
        "text": "Use the present simple for things you do often."
      },
      {
        "start": 2.9,
        "end": 4.44,
        "text": "Read and like are ordinary verbs."
      },
      {
        "start": 5.1,
        "end": 5.82,
        "text": "Read is an action."
      },
      {
        "start": 6.18,
        "end": 6.74,
        "text": "Like is not."
      },
      {
        "start": 7.3,
        "end": 9.48,
        "text": "This unit is about I, you, we and they."
      },
      {
        "start": 9.82,
        "end": 11.98,
        "text": "He, she and it come in Unit 3."
      },
      {
        "start": 11.98,
        "end": 12.7,
        "text": "Person, Verb."
      },
      {
        "start": 13.38,
        "end": 13.86,
        "text": "I, read."
      },
      {
        "start": 14.16,
        "end": 14.64,
        "text": "you, read."
      },
      {
        "start": 14.96,
        "end": 15.42,
        "text": "we, read."
      },
      {
        "start": 15.78,
        "end": 16.3,
        "text": "they, read."
      },
      {
        "start": 16.3,
        "end": 20.12,
        "text": "Rule: After I, you, we and they, the verb stays the same."
      },
      {
        "start": 20.84,
        "end": 21.9,
        "text": "I read books every day."
      },
      {
        "start": 22.3,
        "end": 23.4,
        "text": "You eat breakfast at home."
      },
      {
        "start": 23.76,
        "end": 25,
        "text": "We walk to school on Mondays."
      },
      {
        "start": 25.4,
        "end": 26.1,
        "text": "I like cats."
      },
      {
        "start": 26.56,
        "end": 27.12,
        "text": "We need water."
      },
      {
        "start": 27.72,
        "end": 29.58,
        "text": "Watch out:\n\nWrong: I am read."
      },
      {
        "start": 29.8,
        "end": 30.82,
        "text": "Right: I read."
      },
      {
        "start": 31.28,
        "end": 31.92,
        "text": "Am is extra."
      },
      {
        "start": 32.42,
        "end": 33.66,
        "text": "Wrong: We walks to school."
      },
      {
        "start": 34.3,
        "end": 35.4,
        "text": "Right: We walk to school."
      },
      {
        "start": 35.98,
        "end": 37.7,
        "text": "After we, the verb stays the same."
      },
      {
        "start": 38.38,
        "end": 40.92,
        "text": "Use do to ask and do not to say no."
      },
      {
        "start": 41.96,
        "end": 43.88,
        "text": "Person, Do question, Short answers."
      },
      {
        "start": 44.68,
        "end": 47.1,
        "text": "I, Do I need a book, Yes, you do."
      },
      {
        "start": 47.78,
        "end": 48.64,
        "text": "/ No, you don't."
      },
      {
        "start": 49.56,
        "end": 53.02,
        "text": "you (only you), Do you read at home, Yes, I do."
      },
      {
        "start": 53.64,
        "end": 54.28,
        "text": "/ No, I don't."
      },
      {
        "start": 54.98,
        "end": 58,
        "text": "you (a group), Do you read at home, Yes, we do."
      },
      {
        "start": 58.36,
        "end": 59.2,
        "text": "/ No, we don't."
      },
      {
        "start": 59.2,
        "end": 64.16,
        "text": "we, Do we need a pen, Yes, we do."
      },
      {
        "start": 64.16,
        "end": 67.38,
        "text": "/ No, we don't."
      },
      {
        "start": 69.19,
        "end": 73.47,
        "text": "they, Do they walk to school, Yes, they do."
      },
      {
        "start": 75.73,
        "end": 77.11,
        "text": "/ No, they don't."
      },
      {
        "start": 77.89,
        "end": 83.03,
        "text": "Use do not to say no:\n\nSentence, With do not."
      },
      {
        "start": 84.67,
        "end": 87.57,
        "text": "I read, I do not read."
      },
      {
        "start": 88.01,
        "end": 89.49,
        "text": "They walk, They don't walk."
      },
      {
        "start": 90.67,
        "end": 94.97,
        "text": "A question word comes first, then do:\n\nQuestion word, Asks about, Example."
      },
      {
        "start": 95.83,
        "end": 97.41,
        "text": "What, a thing, What do you read."
      },
      {
        "start": 97.93,
        "end": 99.95,
        "text": "Where, a place, Where do you eat lunch."
      },
      {
        "start": 100.55,
        "end": 102.21,
        "text": "When, a time, When do you read."
      },
      {
        "start": 103.01,
        "end": 105.45,
        "text": "Rule: To ask, put do before the person."
      },
      {
        "start": 105.89,
        "end": 108.69,
        "text": "To say no, put do not before the verb."
      },
      {
        "start": 109.23,
        "end": 110.09,
        "text": "Do they play games?"
      },
      {
        "start": 110.55,
        "end": 111.15,
        "text": "Yes, they do."
      },
      {
        "start": 111.77,
        "end": 112.81,
        "text": "I don't eat lunch at home."
      },
      {
        "start": 113.19,
        "end": 113.97,
        "text": "What do you eat for lunch?"
      },
      {
        "start": 114.17,
        "end": 114.77,
        "text": "Where do they play?"
      },
      {
        "start": 115.61,
        "end": 117.67,
        "text": "Watch out:\n\nWrong: Are you read?"
      },
      {
        "start": 117.95,
        "end": 118.85,
        "text": "Right: Do you read?"
      },
      {
        "start": 119.59,
        "end": 120.95,
        "text": "Read is an ordinary verb."
      },
      {
        "start": 121.49,
        "end": 122.49,
        "text": "Wrong: Do you are ready?"
      },
      {
        "start": 123.15,
        "end": 124.09,
        "text": "Right: Are you ready?"
      },
      {
        "start": 124.77,
        "end": 126.75,
        "text": "Never use do with am, is or are."
      },
      {
        "start": 127.15,
        "end": 128.47,
        "text": "Wrong: I not read."
      },
      {
        "start": 129.21,
        "end": 130.53,
        "text": "Right: I do not read."
      },
      {
        "start": 131.47,
        "end": 132.37,
        "text": "Put do before not."
      },
      {
        "start": 133.17,
        "end": 134.77,
        "text": "Don't is the short form of do not."
      },
      {
        "start": 135.31,
        "end": 136.59,
        "text": "Full form, Short form."
      },
      {
        "start": 137.23,
        "end": 138.57,
        "text": "I do not play, I don't play."
      },
      {
        "start": 139.11,
        "end": 140.51,
        "text": "They do not eat, They don't eat."
      },
      {
        "start": 141.17,
        "end": 143.67,
        "text": "Rule: Don't and do not mean the same thing."
      },
      {
        "start": 144.01,
        "end": 145.07,
        "text": "We do not walk to school."
      },
      {
        "start": 145.07,
        "end": 146.39,
        "text": "We don't walk to school."
      },
      {
        "start": 146.95,
        "end": 148.13,
        "text": "I don't like cats."
      },
      {
        "start": 149.85,
        "end": 150.75,
        "text": "Do you play?"
      },
      {
        "start": 152.31,
        "end": 154.65,
        "text": "No, I don't."
      },
      {
        "start": 156.79,
        "end": 166.04,
        "text": "Watch out:\n\nWrong: dont Right: don't Write the apostrophe."
      },
      {
        "start": 168.69,
        "end": 177.25,
        "text": "Wrong: do'nt Right: don't The apostrophe goes where the o was."
      },
      {
        "start": 177.77,
        "end": 181.51,
        "text": "Spelling:\n\nIn don't, the o from not is gone."
      },
      {
        "start": 182.25,
        "end": 184.09,
        "text": "The apostrophe ' is in its place."
      }
