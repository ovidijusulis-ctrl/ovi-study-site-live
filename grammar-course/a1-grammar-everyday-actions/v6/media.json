{
  "audio": {
    "src": "https://pub-13abeb101e2945d2a7f60234f6faf52e.r2.dev/materials/a1-grammar-everyday-actions/audio/main-9a6b666f60a3.mp3",
    "durationSec": 194.136,
    "cues": [
      {
        "start": 0,
        "end": 2.32,
        "text": "Use the present simple for things you do often."
      },
      {
        "start": 2.98,
        "end": 4.64,
        "text": "Read and like are ordinary verbs."
      },
      {
        "start": 5.22,
        "end": 5.9,
        "text": "Read is an action."
      },
      {
        "start": 6.36,
        "end": 6.92,
        "text": "Like is not."
      },
      {
        "start": 7.84,
        "end": 9.94,
        "text": "This unit is about I, you, we and they."
      },
      {
        "start": 10.32,
        "end": 12.6,
        "text": "He, she and it come in Unit 3."
      },
      {
        "start": 12.6,
        "end": 13.16,
        "text": "Person, Verb."
      },
      {
        "start": 13.52,
        "end": 13.98,
        "text": "I, read."
      },
      {
        "start": 14.28,
        "end": 14.68,
        "text": "you, read."
      },
      {
        "start": 14.8,
        "end": 15.22,
        "text": "we, read."
      },
      {
        "start": 15.42,
        "end": 15.86,
        "text": "they, read."
      },
      {
        "start": 16.62,
        "end": 19.22,
        "text": "Rule: After I, you, we and they, the verb stays the same."
      },
      {
        "start": 19.46,
        "end": 20.46,
        "text": "I read books every day."
      },
      {
        "start": 20.72,
        "end": 21.7,
        "text": "You eat breakfast at home."
      },
      {
        "start": 22,
        "end": 23.2,
        "text": "We walk to school on Mondays."
      },
      {
        "start": 23.76,
        "end": 24.48,
        "text": "I like cats."
      },
      {
        "start": 24.74,
        "end": 25.3,
        "text": "We need water."
      },
      {
        "start": 25.8,
        "end": 27.84,
        "text": "Watch out:\n\nWrong: I am read."
      },
      {
        "start": 28.5,
        "end": 29.52,
        "text": "Right: I read."
      },
      {
        "start": 29.66,
        "end": 30.52,
        "text": "Am is extra."
      },
      {
        "start": 31.22,
        "end": 32.44,
        "text": "Wrong: We walks to school."
      },
      {
        "start": 32.98,
        "end": 34.36,
        "text": "Right: We walk to school."
      },
      {
        "start": 34.94,
        "end": 36.68,
        "text": "After we, the verb stays the same."
      },
      {
        "start": 37.36,
        "end": 40.08,
        "text": "Use do to ask with I, you, we and they."
      },
      {
        "start": 40.68,
        "end": 43.03,
        "text": "He, she and it come in Unit 3."
      },
      {
        "start": 43.03,
        "end": 45.46,
        "text": "Person, Do question, Short answers."
      },
      {
        "start": 46.3,
        "end": 48.66,
        "text": "I, Do I need a book, Yes, you do."
      },
      {
        "start": 48.66,
        "end": 50.02,
        "text": "/ No, you don't."
      },
      {
        "start": 50.62,
        "end": 53.58,
        "text": "you (only you), Do you read at home, Yes, I do."
      },
      {
        "start": 54,
        "end": 54.94,
        "text": "/ No, I don't."
      },
      {
        "start": 55.52,
        "end": 58.28,
        "text": "you (a group), Do you read at home, Yes, we do."
      },
      {
        "start": 58.28,
        "end": 60.44,
        "text": "/ No, we don't."
      },
      {
        "start": 60.44,
        "end": 65.66,
        "text": "we, Do we need a pen, Yes, we do."
      },
      {
        "start": 68.58,
        "end": 69.6,
        "text": "/ No, we don't."
      },
      {
        "start": 71.9,
        "end": 74.78,
        "text": "they, Do they walk to school, Yes, they do."
      },
      {
        "start": 77.46,
        "end": 78.74,
        "text": "/ No, they don't."
      },
      {
        "start": 79.04,
        "end": 82.7,
        "text": "Do not goes before the verb:\n\nSentence, With do not."
      },
      {
        "start": 83.2,
        "end": 84.68,
        "text": "I read, I do not read."
      },
      {
        "start": 85.12,
        "end": 86.44,
        "text": "They walk, They don't walk."
      },
      {
        "start": 87.2,
        "end": 91.7,
        "text": "A question word comes first, then do:\n\nQuestion word, Asks about, Example."
      },
      {
        "start": 92.36,
        "end": 94.02,
        "text": "What, a thing, What do you read."
      },
      {
        "start": 94.02,
        "end": 96.48,
        "text": "Where, a place, Where do you eat lunch."
      },
      {
        "start": 97.14,
        "end": 99.02,
        "text": "When, a time, When do you read."
      },
      {
        "start": 99.82,
        "end": 102.2,
        "text": "Rule: To ask, put do before the person."
      },
      {
        "start": 102.7,
        "end": 105.14,
        "text": "To say no, put do not before the verb."
      },
      {
        "start": 105.58,
        "end": 106.44,
        "text": "Do they play games?"
      },
      {
        "start": 106.98,
        "end": 107.72,
        "text": "Yes, they do."
      },
      {
        "start": 108.48,
        "end": 109.54,
        "text": "I don't eat lunch at home."
      },
      {
        "start": 110.58,
        "end": 111.48,
        "text": "What do you eat for lunch?"
      },
      {
        "start": 112.26,
        "end": 113.1,
        "text": "Where do they play?"
      },
      {
        "start": 113.56,
        "end": 114.98,
        "text": "Watch out:\n\nWrong: Are you read?"
      },
      {
        "start": 115.3,
        "end": 116.26,
        "text": "Right: Do you read?"
      },
      {
        "start": 116.52,
        "end": 118.1,
        "text": "Use do with read, play and eat."
      },
      {
        "start": 118.58,
        "end": 120.26,
        "text": "Use be with happy, ready and here."
      },
      {
        "start": 120.9,
        "end": 121.74,
        "text": "Wrong: Do you are ready?"
      },
      {
        "start": 121.94,
        "end": 122.5,
        "text": "Right: Are you ready?"
      },
      {
        "start": 122.91,
        "end": 124.92,
        "text": "Never use do with am, is or are."
      },
      {
        "start": 124.92,
        "end": 126.16,
        "text": "Wrong: I not read."
      },
      {
        "start": 126.56,
        "end": 127.58,
        "text": "Right: I do not read."
      },
      {
        "start": 128.26,
        "end": 129.4,
        "text": "Put do before not."
      },
      {
        "start": 130.56,
        "end": 132.22,
        "text": "Don't is the short form of do not."
      },
      {
        "start": 132.64,
        "end": 134.1,
        "text": "Full form, Short form."
      },
      {
        "start": 134.44,
        "end": 136.18,
        "text": "I do not play, I don't play."
      },
      {
        "start": 136.58,
        "end": 139.5,
        "text": "They do not eat, They don't eat."
      },
      {
        "start": 140.34,
        "end": 143.68,
        "text": "Rule: Don't and do not mean the same thing."
      },
      {
        "start": 146.87,
        "end": 148.35,
        "text": "We do not walk to school."
      },
      {
        "start": 149.83,
        "end": 151.23,
        "text": "We don't walk to school."
      },
      {
        "start": 154.18,
        "end": 155.26,
        "text": "I don't like cats."
      },
      {
        "start": 155.26,
        "end": 160.65,
        "text": "Do you play?"
      },
      {
        "start": 161.65,
        "end": 162.59,
        "text": "No, I don't."
      },
      {
        "start": 162.95,
        "end": 170.65,
        "text": "Watch out:\n\nWrong: dont Right: don't Write the apostrophe."
      },
      {
        "start": 172.69,
        "end": 185.54,
        "text": "Wrong: do'nt Right: don't The apostrophe goes where the o was."
      },
      {
        "start": 186.94,
        "end": 189.98,
        "text": "Spelling:\n\nIn don't, the o from not is gone."
      },
      {
        "start": 189.98,
        "end": 193.56,
        "text": "The apostrophe ' is in its place."
      }
