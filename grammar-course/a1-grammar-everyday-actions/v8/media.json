{
  "audio": {
    "src": "https://pub-13abeb101e2945d2a7f60234f6faf52e.r2.dev/materials/a1-grammar-everyday-actions/audio/main-7150fa3c1f22.mp3",
    "durationSec": 199.296,
    "cues": [
      {
        "start": 0,
        "end": 2.2,
        "text": "Use the present simple for things you do often."
      },
      {
        "start": 2.8,
        "end": 4.26,
        "text": "Read and like are ordinary verbs."
      },
      {
        "start": 4.84,
        "end": 5.56,
        "text": "Read is an action."
      },
      {
        "start": 6.14,
        "end": 6.72,
        "text": "Like is not."
      },
      {
        "start": 7.54,
        "end": 9.88,
        "text": "This unit is about I, you, we and they."
      },
      {
        "start": 10.24,
        "end": 12.93,
        "text": "Doing words with he, she and it come in Unit 3."
      },
      {
        "start": 12.93,
        "end": 14.08,
        "text": "Person, Verb."
      },
      {
        "start": 14.68,
        "end": 15.22,
        "text": "I, read."
      },
      {
        "start": 15.68,
        "end": 16.18,
        "text": "you, read."
      },
      {
        "start": 16.62,
        "end": 17.16,
        "text": "we, read."
      },
      {
        "start": 17.66,
        "end": 18.24,
        "text": "they, read."
      },
      {
        "start": 18.24,
        "end": 22.66,
        "text": "Rule: After I, you, we and they, the verb stays the same."
      },
      {
        "start": 23.5,
        "end": 24.58,
        "text": "I read books every day."
      },
      {
        "start": 24.94,
        "end": 26,
        "text": "You eat breakfast at home."
      },
      {
        "start": 26.38,
        "end": 27.6,
        "text": "We walk to school on Mondays."
      },
      {
        "start": 27.96,
        "end": 28.58,
        "text": "I like cats."
      },
      {
        "start": 28.7,
        "end": 29.18,
        "text": "We need water."
      },
      {
        "start": 29.18,
        "end": 31.24,
        "text": "Watch out:\n\nWrong: I am read."
      },
      {
        "start": 31.74,
        "end": 32.6,
        "text": "Right: I read."
      },
      {
        "start": 33.18,
        "end": 34.02,
        "text": "Am is extra."
      },
      {
        "start": 34.76,
        "end": 36.06,
        "text": "Wrong: We walks to school."
      },
      {
        "start": 36.38,
        "end": 37.58,
        "text": "Right: We walk to school."
      },
      {
        "start": 37.98,
        "end": 39.8,
        "text": "After we, the verb stays the same."
      },
      {
        "start": 40.42,
        "end": 42.92,
        "text": "Use do to ask with I, you, we and they."
      },
      {
        "start": 43.52,
        "end": 46.56,
        "text": "Doing words with he, she and it come in Unit 3."
      },
      {
        "start": 46.56,
        "end": 49.04,
        "text": "Person, Do question, Short answers."
      },
      {
        "start": 49.94,
        "end": 52.22,
        "text": "I, Do I need a book, Yes, you do."
      },
      {
        "start": 52.66,
        "end": 53.42,
        "text": "/ No, you don't."
      },
      {
        "start": 54.1,
        "end": 57,
        "text": "you (only you), Do you read at home, Yes, I do."
      },
      {
        "start": 57.36,
        "end": 58.14,
        "text": "/ No, I don't."
      },
      {
        "start": 58.14,
        "end": 65.5,
        "text": "you (a group), Do you read at home, Yes, we do."
      },
      {
        "start": 65.5,
        "end": 69.16,
        "text": "/ No, we don't."
      },
      {
        "start": 70.4,
        "end": 76.4,
        "text": "we, Do we need a pen, Yes, we do."
      },
      {
        "start": 78.04,
        "end": 80.2,
        "text": "/ No, we don't."
      },
      {
        "start": 81.62,
        "end": 87.28,
        "text": "they, Do they walk to school, Yes, they do."
      },
      {
        "start": 87.28,
        "end": 90.78,
        "text": "/ No, they don't."
      },
      {
        "start": 91.08,
        "end": 94.22,
        "text": "Put do not before the verb:\n\nSentence, With do not."
      },
      {
        "start": 94.64,
        "end": 96,
        "text": "I read, I do not read."
      },
      {
        "start": 96.52,
        "end": 97.92,
        "text": "They walk, They don't walk."
      },
      {
        "start": 98.58,
        "end": 102.94,
        "text": "A question word comes first, then do:\n\nQuestion word, Asks about, Example."
      },
      {
        "start": 103.6,
        "end": 105.42,
        "text": "What, a thing, What do you read."
      },
      {
        "start": 105.98,
        "end": 107.84,
        "text": "Where, a place, Where do you eat lunch."
      },
      {
        "start": 108.38,
        "end": 110.04,
        "text": "When, a time, When do you read."
      },
      {
        "start": 110.76,
        "end": 113.96,
        "text": "Rule: With I, you, we and they, use do with ordinary verbs."
      },
      {
        "start": 114.44,
        "end": 116.7,
        "text": "In a yes/no question, put do first."
      },
      {
        "start": 117.3,
        "end": 119.86,
        "text": "To say no, put do not before the verb."
      },
      {
        "start": 120.62,
        "end": 121.42,
        "text": "Do they play games?"
      },
      {
        "start": 121.76,
        "end": 122.52,
        "text": "Yes, they do."
      },
      {
        "start": 122.96,
        "end": 123.88,
        "text": "I don't eat lunch at home."
      },
      {
        "start": 124.3,
        "end": 125.14,
        "text": "What do you eat for lunch?"
      },
      {
        "start": 125.64,
        "end": 126.4,
        "text": "Where do they play?"
      },
      {
        "start": 127.02,
        "end": 128.62,
        "text": "Watch out:\n\nWrong: Are you read?"
      },
      {
        "start": 129.04,
        "end": 129.82,
        "text": "Right: Do you read?"
      },
      {
        "start": 130.36,
        "end": 132,
        "text": "Use do with read, play and eat."
      },
      {
        "start": 132.7,
        "end": 135.28,
        "text": "Use be with happy, ready and here."
      },
      {
        "start": 135.28,
        "end": 136.04,
        "text": "Wrong: Do you are ready?"
      },
      {
        "start": 136.54,
        "end": 137.46,
        "text": "Right: Are you ready?"
      },
      {
        "start": 138.12,
        "end": 139.98,
        "text": "Never use do with am, is or are."
      },
      {
        "start": 140.4,
        "end": 141.62,
        "text": "Wrong: I not read."
      },
      {
        "start": 142.06,
        "end": 143.08,
        "text": "Right: I do not read."
      },
      {
        "start": 143.42,
        "end": 144.62,
        "text": "Put do before not."
      },
      {
        "start": 145.6,
        "end": 147.7,
        "text": "Don't is the short form of do not."
      },
      {
        "start": 148.12,
        "end": 149.82,
        "text": "Full form, Short form."
      },
      {
        "start": 151.62,
        "end": 155.48,
        "text": "I do not play, I don't play."
      },
      {
        "start": 157.4,
        "end": 161.02,
        "text": "They do not eat, They don't eat."
      },
      {
        "start": 164.1,
        "end": 167.1,
        "text": "Rule: Don't and do not mean the same thing."
      },
      {
        "start": 168.76,
        "end": 170.24,
        "text": "We do not walk to school."
      },
      {
        "start": 171.82,
        "end": 173.36,
        "text": "We don't walk to school."
      },
      {
        "start": 173.66,
        "end": 175.04,
        "text": "I don't like cats."
      },
      {
        "start": 175.32,
        "end": 176.06,
        "text": "Do you play?"
      },
      {
        "start": 176.66,
        "end": 178.1,
        "text": "No, I don't."
      },
      {
        "start": 178.28,
        "end": 185,
        "text": "Watch out:\n\nWrong: dont Right: don't Write the apostrophe."
      },
      {
        "start": 185.76,
        "end": 192.66,
        "text": "Wrong: do'nt Right: don't The apostrophe goes where the o was."
      },
      {
        "start": 193,
        "end": 196.22,
        "text": "Spelling:\n\nIn don't, the o from not is gone."
      },
      {
        "start": 196.62,
        "end": 198.72,
        "text": "The apostrophe ' takes its place."
      }
