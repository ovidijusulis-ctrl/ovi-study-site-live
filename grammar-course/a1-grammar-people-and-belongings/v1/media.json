{
  "audio": {
    "src": "https://pub-13abeb101e2945d2a7f60234f6faf52e.r2.dev/materials/a1-grammar-people-and-belongings/audio/main-3d22d93cf68d.mp3",
    "durationSec": 199.584,
    "cues": [
      {
        "start": 0,
        "end": 2.28,
        "text": "A pronoun takes the place of a name or noun."
      },
      {
        "start": 2.28,
        "end": 4.1,
        "text": "Subject, Object."
      },
      {
        "start": 4.46,
        "end": 5.12,
        "text": "I, me."
      },
      {
        "start": 5.36,
        "end": 6.14,
        "text": "you, you."
      },
      {
        "start": 6.34,
        "end": 7.02,
        "text": "he, him."
      },
      {
        "start": 7.32,
        "end": 7.9,
        "text": "she, her."
      },
      {
        "start": 8.16,
        "end": 8.66,
        "text": "it, it."
      },
      {
        "start": 8.88,
        "end": 9.3,
        "text": "we, us."
      },
      {
        "start": 9.54,
        "end": 10.02,
        "text": "they, them."
      },
      {
        "start": 10.46,
        "end": 13.7,
        "text": "Rule: The subject tells who or what the sentence describes."
      },
      {
        "start": 14.2,
        "end": 17.22,
        "text": "Use objects for who gets help, or after to, for, with."
      },
      {
        "start": 17.92,
        "end": 18.46,
        "text": "Ken helps Emma."
      },
      {
        "start": 18.74,
        "end": 19.34,
        "text": "He helps her."
      },
      {
        "start": 19.72,
        "end": 20.32,
        "text": "Emma helps Ken."
      },
      {
        "start": 20.7,
        "end": 21.24,
        "text": "She helps him."
      },
      {
        "start": 21.24,
        "end": 22.22,
        "text": "Ben and I wait."
      },
      {
        "start": 22.58,
        "end": 22.92,
        "text": "We wait."
      },
      {
        "start": 23.62,
        "end": 24.54,
        "text": "This bag is for us."
      },
      {
        "start": 25.16,
        "end": 26.26,
        "text": "Emma and Ben need maps."
      },
      {
        "start": 26.78,
        "end": 27.44,
        "text": "They need maps."
      },
      {
        "start": 27.94,
        "end": 28.3,
        "text": "Help them."
      },
      {
        "start": 28.3,
        "end": 29.24,
        "text": "You help me."
      },
      {
        "start": 29.38,
        "end": 29.94,
        "text": "I help you."
      },
      {
        "start": 30.2,
        "end": 30.66,
        "text": "It is here."
      },
      {
        "start": 31.12,
        "end": 31.56,
        "text": "Take it."
      },
      {
        "start": 32,
        "end": 33.5,
        "text": "Watch out:\n\n✗ Is her here?"
      },
      {
        "start": 34.62,
        "end": 35.26,
        "text": "✓ Is she here?"
      },
      {
        "start": 35.84,
        "end": 37.2,
        "text": "Questions use subjects, too."
      },
      {
        "start": 37.58,
        "end": 38.14,
        "text": "✗ Come with she."
      },
      {
        "start": 38.6,
        "end": 39.14,
        "text": "✓ Come with her."
      },
      {
        "start": 39.72,
        "end": 40.34,
        "text": "Use an object."
      },
      {
        "start": 40.92,
        "end": 42.7,
        "text": "These words show who things belong to."
      },
      {
        "start": 42.7,
        "end": 44.08,
        "text": "Owner, Before a noun."
      },
      {
        "start": 44.48,
        "end": 45.2,
        "text": "I, my book."
      },
      {
        "start": 45.52,
        "end": 46.06,
        "text": "you, your book."
      },
      {
        "start": 46.46,
        "end": 47,
        "text": "he, his book."
      },
      {
        "start": 47.38,
        "end": 47.96,
        "text": "she, her book."
      },
      {
        "start": 48.36,
        "end": 48.98,
        "text": "it, its bed."
      },
      {
        "start": 49.24,
        "end": 49.88,
        "text": "we, our books."
      },
      {
        "start": 50.3,
        "end": 51.1,
        "text": "they, their books."
      },
      {
        "start": 51.54,
        "end": 52.5,
        "text": "Look here and over there."
      },
      {
        "start": 52.9,
        "end": 54.64,
        "text": "Place, One, Two or more."
      },
      {
        "start": 55.08,
        "end": 57.1,
        "text": "Near, This book is new, These books are new."
      },
      {
        "start": 57.1,
        "end": 62.32,
        "text": "Far, That bag is blue, Those bags are blue."
      },
      {
        "start": 62.32,
        "end": 74.72,
        "text": "Rule: Put my, your, his, her, its, our, their before nouns."
      },
      {
        "start": 75.34,
        "end": 77.98,
        "text": "This pen is in my hand."
      },
      {
        "start": 80.6,
        "end": 83.28,
        "text": "That map on the wall is across the room."
      },
      {
        "start": 83.84,
        "end": 85.04,
        "text": "These apples here are sweet."
      },
      {
        "start": 85.78,
        "end": 86.72,
        "text": "Emma and Ben have their books."
      },
      {
        "start": 87.42,
        "end": 89.02,
        "text": "Watch out:\n\n✗ This books."
      },
      {
        "start": 89.46,
        "end": 90.02,
        "text": "✓ These books."
      },
      {
        "start": 90.64,
        "end": 92.38,
        "text": "Use these for two or more books."
      },
      {
        "start": 93.18,
        "end": 93.76,
        "text": "✗ Her helps."
      },
      {
        "start": 94.2,
        "end": 94.76,
        "text": "✓ She helps."
      },
      {
        "start": 95.18,
        "end": 96.42,
        "text": "Her book, but she helps."
      },
      {
        "start": 96.42,
        "end": 97.92,
        "text": "You find a bag at school."
      },
      {
        "start": 98.42,
        "end": 99.54,
        "text": "Before a noun, Alone."
      },
      {
        "start": 100.08,
        "end": 100.74,
        "text": "my book, mine."
      },
      {
        "start": 101.22,
        "end": 102.22,
        "text": "your book, yours."
      },
      {
        "start": 102.54,
        "end": 103.32,
        "text": "his book, his."
      },
      {
        "start": 103.78,
        "end": 105.06,
        "text": "her book, hers."
      },
      {
        "start": 105.06,
        "end": 106.24,
        "text": "its bed, —."
      },
      {
        "start": 106.68,
        "end": 107.56,
        "text": "our books, ours."
      },
      {
        "start": 108.08,
        "end": 109.34,
        "text": "their books, theirs."
      },
      {
        "start": 109.94,
        "end": 111.98,
        "text": "Rule: Ask Whose + thing + is/are…?"
      },
      {
        "start": 111.98,
        "end": 112.62,
        "text": "Whose bag is this?"
      },
      {
        "start": 113.06,
        "end": 113.64,
        "text": "— It is mine."
      },
      {
        "start": 114.02,
        "end": 114.8,
        "text": "— Here is your bag."
      },
      {
        "start": 115.04,
        "end": 115.7,
        "text": "This is my book."
      },
      {
        "start": 116.12,
        "end": 116.82,
        "text": "This book is mine."
      },
      {
        "start": 117.68,
        "end": 118.4,
        "text": "Whose maps are these?"
      },
      {
        "start": 118.68,
        "end": 119.1,
        "text": "They are theirs."
      },
      {
        "start": 119.56,
        "end": 120.1,
        "text": "Is this yours?"
      },
      {
        "start": 120.62,
        "end": 121.34,
        "text": "Yes, it is."
      },
      {
        "start": 121.56,
        "end": 122.3,
        "text": "/ No, it isn't."
      },
      {
        "start": 123.06,
        "end": 124.94,
        "text": "Watch out:\n\n✗ Mine book."
      },
      {
        "start": 125.3,
        "end": 125.8,
        "text": "✓ My book."
      },
      {
        "start": 125.8,
        "end": 127.02,
        "text": "Mine stands alone."
      },
      {
        "start": 127.02,
        "end": 128.28,
        "text": "✗ Who's bag?"
      },
      {
        "start": 128.74,
        "end": 129.26,
        "text": "✓ Whose bag?"
      },
      {
        "start": 129.62,
        "end": 131.08,
        "text": "Write who is as who's."
      },
      {
        "start": 131.08,
        "end": 133.46,
        "text": "His works both ways: his book; the book is his."
      },
      {
        "start": 134.06,
        "end": 136,
        "text": "Use its before a noun here, not alone."
      },
      {
        "start": 136.62,
        "end": 138.76,
        "text": "An apostrophe can show who something belongs to."
      },
      {
        "start": 138.76,
        "end": 140.42,
        "text": "Owners, Spelling."
      },
      {
        "start": 140.94,
        "end": 142.68,
        "text": "One student, student's."
      },
      {
        "start": 142.68,
        "end": 144.42,
        "text": "Two students, students'."
      },
      {
        "start": 144.42,
        "end": 147.56,
        "text": "Rule: Add 's for one owner."
      },
      {
        "start": 148.02,
        "end": 151.14,
        "text": "For plural owners ending in s, add ' after s."
      },
      {
        "start": 151.96,
        "end": 152.96,
        "text": "This is Ken's bag."
      },
      {
        "start": 154.68,
        "end": 156.02,
        "text": "One student's books are here."
      },
      {
        "start": 156.48,
        "end": 157.94,
        "text": "Two students' books are there."
      },
      {
        "start": 158.84,
        "end": 160.4,
        "text": "Our dog sleeps in its bed."
      },
      {
        "start": 161.64,
        "end": 162.26,
        "text": "It's tired."
      },
      {
        "start": 163.1,
        "end": 163.92,
        "text": "Look at your bag."
      },
      {
        "start": 164.52,
        "end": 164.96,
        "text": "You're ready."
      },
      {
        "start": 167.46,
        "end": 173.27,
        "text": "Watch out:\n\n✗ The dog plays with it's ball."
      },
      {
        "start": 174.79,
        "end": 176.93,
        "text": "✓ The dog plays with its ball."
      },
      {
        "start": 176.93,
        "end": 178.57,
        "text": "✗ Kens pen."
      },
      {
        "start": 179.29,
        "end": 179.81,
        "text": "✓ Ken's pen."
      },
      {
        "start": 181.39,
        "end": 182.71,
        "text": "Ken is one owner."
      },
      {
        "start": 184.65,
        "end": 189.99,
        "text": "Spelling: Write it is tired as it's tired."
      },
      {
        "start": 189.99,
        "end": 193.33,
        "text": "Its shows belonging."
      },
      {
        "start": 194.93,
        "end": 199.11,
        "text": "Your shows belonging; write you are as you're."
      }
