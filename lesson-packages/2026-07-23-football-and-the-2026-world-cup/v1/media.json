{"audio":{"src":"https://pub-13abeb101e2945d2a7f60234f6faf52e.r2.dev/materials/2026-07-23-football-and-the-2026-world-cup/audio/main-94072f0e87fe.mp3","durationSec":98.904,"cues":[{"start":0,"end":1.88,"text":"The FIFA World Cup is a football tournament."},{"start":1.88,"end":4.46,"text":"Teams from around the world play against each other."},{"start":4.88,"end":7,"text":"One team wins and becomes world champion."},{"start":7.82,"end":9.4,"text":"A football match has two teams."},{"start":9.86,"end":11.4,"text":"Each team has up to eleven players."},{"start":12,"end":13.54,"text":"One player on each team is the goalkeeper."},{"start":14.24,"end":16.68,"text":"The match has two halves of 45 minutes each."},{"start":17.28,"end":19.16,"text":"The team that scores more goals wins."},{"start":20.16,"end":22.78,"text":"The 2026 World Cup was different from older tournaments."},{"start":23.42,"end":25.86,"text":"For the first time, 48 teams played."},{"start":26.36,"end":28.1,"text":"That is more teams than ever before."},{"start":28.68,"end":30.88,"text":"There were 104 matches in total."},{"start":31.64,"end":37.72,"text":"Three countries hosted the tournament together: Canada, Mexico, and the United States."},{"start":38.98,"end":44.22,"text":"The tournament started in June 2026 and the final was on 19 July 2026."},{"start":44.96,"end":49.46,"text":"The final match was on 19 July 2026 in New York/New Jersey."},{"start":50.16,"end":51.48,"text":"Spain played against Argentina."},{"start":51.96,"end":53.5,"text":"It was a very close match."},{"start":54.14,"end":58.46,"text":"After 90 minutes the score was 0–0, so the teams played extra time."},{"start":59.08,"end":61.3,"text":"In extra time, Spain scored one goal."},{"start":61.94,"end":63.92,"text":"Spain won 1–0."},{"start":63.92,"end":66.76,"text":"Spain became the 2026 World Cup champions."},{"start":67.44,"end":68.82,"text":"Argentina did not score."},{"start":69.64,"end":74.24,"text":"Sometimes a match ends 0–0 or with the same score after 90 minutes."},{"start":74.68,"end":76.04,"text":"This is called a draw."},{"start":76.88,"end":79.18,"text":"In a final, there must be a winner."},{"start":79.82,"end":83.06,"text":"So the teams play extra time — two more short halves."},{"start":83.68,"end":88.78,"text":"If the score is still equal after extra time, the teams use a penalty shoot-out."},{"start":88.78,"end":91.66,"text":"Each team takes turns kicking the ball from the penalty spot."},{"start":92.62,"end":98.46,"text":"In the 2026 final, Spain scored in extra time, so there was no penalty shoot-out."}],"words":[{"text":"The","start":0,"end":0.16},{"text":"FIFA","start":0.16,"end":0.4},{"text":"World","start":0.4,"end":0.66},{"text":"Cup","start":0.66,"end":0.9},{"text":"is","start":0.9,"end":1.08},{"text":"a","start":1.08,"end":1.2},{"text":"football","start":1.2,"end":1.46},{"text":"tournament","start":1.46,"end":1.88},{"text":"Teams","start":1.88,"end":2.54},{"text":"from","start":2.54,"end":2.76},{"text":"around","start":2.76,"end":3.04},{"text":"the","start":3.04,"end":3.18},{"text":"world","start":3.18,"end":3.42},{"text":"play","start":3.42,"end":3.68},{"text":"against","start":3.68,"end":3.94},{"text":"each","start":3.94,"end":4.2},{"text":"other","start":4.2,"end":4.46},{"text":"One","start":4.88,"end":5.02},{"text":"team","start":5.02,"end":5.28},{"text":"wins","start":5.28,"end":5.62},{"text":"and","start":5.62,"end":5.96},{"text":"becomes","start":5.96,"end":6.28},{"text":"world","start":6.28,"end":6.58},{"text":"champion","start":6.58,"end":7},{"text":"A","start":7.82,"end":8.02},{"text":"football","start":8.02,"end":8.26},{"text":"match","start":8.26,"end":8.54},{"text":"has","start":8.54,"end":8.76},{"text":"two","start":8.76,"end":9.04},{"text":"teams","start":9.04,"end":9.4},{"text":"Each","start":9.86,"end":9.98},{"text":"team","start":9.98,"end":10.22},{"text":"has","start":10.22,"end":10.4},{"text":"up","start":10.4,"end":10.54},{"text":"to","start":10.54,