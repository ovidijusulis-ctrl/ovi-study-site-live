{"audio":{"src":"https://pub-13abeb101e2945d2a7f60234f6faf52e.r2.dev/materials/a1-explainer-about-a-boy-and-superheroes-write-for-a-middle-school-student-short-words-sho/audio/main-e6fcf10bce33.mp3","durationSec":135.528,"cues":[{"start":0,"end":0.86,"text":"Leo is a boy."},{"start":0.86,"end":2.54,"text":"Leo is seven years old."},{"start":3.24,"end":4.92,"text":"Superheroes are helpers in stories."},{"start":5.68,"end":7.08,"text":"Leo loves superhero stories."},{"start":7.74,"end":8.92,"text":"Leo reads hero books at night."},{"start":9.68,"end":11.2,"text":"Leo draws heroes with red coats."},{"start":11.94,"end":13.62,"text":"Leo draws heroes who save people."},{"start":14.12,"end":15.58,"text":"Leo puts the drawings on his wall."},{"start":16.26,"end":17.54,"text":"Leo wants to be a hero too."},{"start":18.1,"end":19.56,"text":"Leo thinks a hero must be big."},{"start":20.16,"end":21.56,"text":"Leo thinks a hero must fly."},{"start":22.34,"end":23.18,"text":"Leo is small."},{"start":23.66,"end":24.4,"text":"Leo cannot fly."},{"start":25.02,"end":26.48,"text":"Leo feels sad about that sometimes."},{"start":27.18,"end":28.62,"text":"Mina is Leo's little sister."},{"start":29.04,"end":30.02,"text":"Mina is four years old."},{"start":30.78,"end":31.72,"text":"Mina has a red kite."},{"start":32.38,"end":34.3,"text":"Mina loves the red kite very much."},{"start":34.84,"end":35.8,"text":"Leo and Mina go to the park."},{"start":36.12,"end":37.14,"text":"The wind is strong today."},{"start":37.44,"end":38.64,"text":"The red kite goes up high."},{"start":39,"end":40.34,"text":"The red kite goes up and up."},{"start":40.9,"end":42.8,"text":"The red kite gets stuck in a tall tree."},{"start":43.52,"end":43.96,"text":"Mina cries."},{"start":44.6,"end":45.66,"text":"Mina wants her red kite."},{"start":46.6,"end":47.58,"text":"Leo looks at the tree."},{"start":48.16,"end":49.24,"text":"The tree is very tall."},{"start":49.82,"end":51.34,"text":"Leo cannot reach the red kite."},{"start":51.86,"end":53.56,"text":"Leo cannot fly to the red kite."},{"start":54.2,"end":55.86,"text":"A helper walks to Leo and Mina."},{"start":55.86,"end":57.56,"text":"The helper is Skye."},{"start":57.74,"end":58.62,"text":"Skye has a blue coat."},{"start":59.44,"end":60.38,"text":"Skye has a kind smile."},{"start":60.88,"end":61.78,"text":"Skye does not shout."},{"start":62.1,"end":62.98,"text":"Skye does not fight."},{"start":63.78,"end":65.48,"text":"Skye says hello to Mina in a soft voice."},{"start":66.1,"end":67.76,"text":"Skye says the red kite is safe in the tree."},{"start":68.34,"end":69.76,"text":"Skye says they can get it down together."},{"start":70.46,"end":71.32,"text":"Skye makes a plan."},{"start":72.3,"end":73.3,"text":"First, they need a ladder."},{"start":73.9,"end":75.82,"text":"Second, they need a grown-up."},{"start":75.82,"end":76.82,"text":"Third, they need to stay calm."},{"start":76.82,"end":78.66,"text":"Leo listens to Skye."},{"start":78.94,"end":79.66,"text":"Leo gets a job."},{"start":80.24,"end":81.54,"text":"Leo runs to Dad on the bench."},{"start":82.08,"end":83.46,"text":"Leo tells Dad about the red kite."},{"start":84.1,"end":85.12,"text":"Dad brings a ladder."},{"start":86.04,"end":86.88,"text":"Skye climbs the ladder."},{"start":86.88,"end":88.18,"text":"Leo holds the ladder."},{"start":88.64,"end":89.76,"text":"Leo holds it very still."},{"start":90.3,"end":91.16,"text":"Mina still cries a little."},{"start":91.78,"end":92.8,"text":"Leo holds Mina's hand."},{"start":93.26,"end":94.58,"text":"Leo tells Mina it is okay."},{"start":95.58,"end":96.54,"text":"Skye reaches the red kite."},{"start":97.26,"end":98.7,"text":"Skye lifts it off the branch."},{"start":99.56,"end":100.64,"text":"Skye comes down slowly."},{"start":101.12,"end":102.54,"text":"Skye gives the red kite to Mina."},{"start":103.06,"end":103.66,"text":"Mina smiles."},{"start":104.14,"end":104.86,"text":"Mina hugs Leo."},{"start":105.6,"end":106.44,"text":"Skye smiles at Leo."},{"start":106.92,"end":108.36,"text":"Skye says Leo was brave today."},{"start":109.06,"end":110.56,"text":"Skye says a hero helps people."},{"start":111.16,"end":112.48,"text":"Skye says a hero stays calm."},{"start":112.48,"end":114.98,"text":"Skye says a hero can be a kid too."},{"start":116,"end":117.56,"text":"Leo looks at his drawings at home."},{"start":118.28,"end":120.04,"text":"Leo still loves big heroes."},{"start":120.74,"end":122.48,"text":"Leo also loves small help."},{"start":123.1,"end":124.02,"text":"Leo can hold a ladder."},{"start":124.46,"end":125.4,"text":"Leo can hold a hand."},{"start":125.98,"end":126.9,"text":"Leo can call Dad."},{"start":127.76,"end":129.36,"text":"Leo can be kind every day."},{"start":129.98,"end":130.98,"text":"Leo feels proud."},{"start":131.82,"end":132.82,"text":"Leo is still a kid."},{"start":133.48,"end":135.12,"text":"Leo is a helper now too."}],"words":[{"text":"Leo","start":0,"end":0.36},{"text":"is","start":0.36,"end":0.5},{"text":"a","start":0.5,"end":0.6},{"text":"boy","start":0.6,"end":0.86},{"text":"Leo","start":0.86,"end":1.6},{"text":"is","start":1.6,"end":1.74},{"text":"seven","start":1.74,"end":2.04},{"text":"years","start":2.04,"end":2.24},{"text":"old","start":2.24,"end":2.54},{"text":"Superheroes","start":3.24,"end":3.72},{"text":"are","start":3.72,"end":3.86},{"text":"helpers","start":3.86,"end":4.26},{"text":"in","start":4.26,"end":4.52},{"text":"stories","start":4.52,"end":4.92},{"text":"Leo","start":5.68,"end":5.78},{"text":"loves","start":5.78,"end":6.14},{"text":"superhero","start":6.14,"end":6.58},{"text":"stories","start":6.58,"end":7.08},{"text":"Leo","start":7.74,"end":7.84},{"text":"reads","start":7.84,"end":8.06},{"text":"hero","start":8.06,"end":8.34},{"text":"books","start":8.34,"end":8.52},{"text":"at","start":8.52,"end":8.7},{"text":"night","start":8.7,"end":8.92},{"text":"Leo","start":9.68,"end":9.84},{"text":"draws","start":9.84,"end":10.14},{"text":"heroes","start"