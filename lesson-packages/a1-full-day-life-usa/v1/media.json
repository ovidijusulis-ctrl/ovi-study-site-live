{"audio":{"src":"https://pub-13abeb101e2945d2a7f60234f6faf52e.r2.dev/materials/a1-full-day-life-usa/audio/main-81a84c4b395c.mp3","durationSec":309.36,"cues":[{"start":0,"end":1.36,"text":"It is seven o'clock in the morning."},{"start":1.72,"end":2.54,"text":"A clock rings."},{"start":3.32,"end":4.76,"text":"Children wake up and get out of bed."},{"start":5.32,"end":7.54,"text":"They wash their face and put on their clothes."},{"start":8.22,"end":9.44,"text":"Then they brush their teeth."},{"start":10.32,"end":11.44,"text":"Now it is time for breakfast."},{"start":12.26,"end":15.6,"text":"Children eat cereal with milk, or eggs and toast."},{"start":16.42,"end":18.36,"text":"They put the cereal in a bowl and add milk."},{"start":18.36,"end":20.74,"text":"Toast is hot, brown bread."},{"start":21.4,"end":22.88,"text":"Fruit is good for breakfast too."},{"start":23.94,"end":25.62,"text":"Children eat a banana or an apple."},{"start":26.18,"end":27.86,"text":"They drink orange juice or milk."},{"start":28.94,"end":31.98,"text":"Breakfast gives them food before a busy day at school."},{"start":32.76,"end":34.8,"text":"After breakfast, children get their school bag."},{"start":35.46,"end":36.5,"text":"It is called a backpack."},{"start":37.22,"end":39.4,"text":"They put in books, pencils and a water bottle."},{"start":39.94,"end":41.4,"text":"They can put a lunch box in too."},{"start":42.3,"end":43.3,"text":"Now they are ready to go."},{"start":44.06,"end":46.28,"text":"Children go to school by bus or by car."},{"start":46.76,"end":47.62,"text":"They can walk too."},{"start":48.24,"end":50.28,"text":"The yellow school bus stops near their home."},{"start":51.06,"end":52.9,"text":"Children get on the bus and sit with friends."},{"start":53.48,"end":54.44,"text":"They look out of the window."},{"start":55.06,"end":56.3,"text":"The bus arrives at school."},{"start":56.3,"end":59.12,"text":"Children get off and say hello to their teacher."},{"start":59.12,"end":61.24,"text":"Children go into their classroom."},{"start":61.84,"end":63.18,"text":"They say hello to their friends."},{"start":63.88,"end":66.26,"text":"They put their bags away and sit at their desks."},{"start":67.18,"end":68.08,"text":"First, they have reading."},{"start":68.8,"end":70.7,"text":"The teacher reads a story to the class."},{"start":71.54,"end":73,"text":"Children listen and look at the book."},{"start":73.64,"end":74.64,"text":"Then they read too."},{"start":75.26,"end":77.46,"text":"They read alone or in small groups."},{"start":77.62,"end":79.38,"text":"They talk about the story with their teacher."},{"start":80.08,"end":80.9,"text":"Next is writing."},{"start":81.62,"end":83.92,"text":"The teacher walks around and helps the children."},{"start":84.64,"end":85.82,"text":"Then they have math."},{"start":86.44,"end":87.36,"text":"They work with numbers."},{"start":87.96,"end":89.34,"text":"They add and take away."},{"start":89.92,"end":91.76,"text":"They use blocks and pictures too."},{"start":92.6,"end":93.82,"text":"The teacher writes on the board."},{"start":94.8,"end":96.64,"text":"Children put a hand up to ask a question."},{"start":97.42,"end":99.1,"text":"After class, it is time to play."},{"start":99.8,"end":101,"text":"This time is called recess."},{"start":102,"end":102.84,"text":"Children go outside."},{"start":103.38,"end":106.02,"text":"They run, jump and play games with friends."},{"start":106.94,"end":108.22,"text":"Then it is time for lunch."},{"start":108.9,"end":111.38,"text":"The school has a big eating room called the cafeteria."},{"start":111.79,"end":113.8,"text":"It has long tables and many chairs."},{"start":113.8,"end":115.58,"text":"Children sit and eat with friends."},{"start":116.3,"end":118.42,"text":"They bring lunch from home or get school lunch."},{"start":118.92,"end":121.46,"text":"A lunch box can have a sandwich, an apple or cheese."},{"start":122.28,"end":125.52,"text":"School lunch can be pizza, chicken, rice, salad or fruit."},{"start":126.28,"end":127.4,"text":"Many children drink milk."},{"start":127.98,"end":129.02,"text":"School meals can be free."},{"start":129.76,"end":131.58,"text":"After lunch, classes start again."},{"start":132.96,"end":134.52,"text":"Children have more to learn and do."},{"start":135.18,"end":137.74,"text":"There is time for art, music, games and science."},{"start":138.34,"end":140.5,"text":"In art class, children draw pictures."},{"start":140.98,"end":142.22,"text":"They paint with many colors."},{"start":142.82,"end":144.12,"text":"They cut paper and make things."},{"start":144.82,"end":146.34,"text":"They show their pictures to the teacher."},{"start":147.44,"end":149.98,"text":"In music class, children sing songs together."},{"start":150.48,"end":152.96,"text":"They listen to music and play small drums or bells."},{"start":154.08,"end":155.3,"text":"PE is sports class."},{"start":156.18,"end":157.86,"text":"Children go to a big room for games."},{"start":158.46,"end":160.66,"text":"They run, throw balls and play in teams."},{"start":161.24,"end":162.46,"text":"They can play outside too."},{"start":163.28,"end":166.78,"text":"In science class, children learn about water and small animals."},{"start":167.28,"end":169.1,"text":"They look at pictures and ask questions."},{"start":169.56,"end":171.22,"text":"The teacher helps them find answers."},{"start":172.12,"end":174.5,"text":"At the end of the day, children clean the classroom."},{"start":175.1,"end":177,"text":"They put their books away and clean their desks."},{"start":177.62,"end":178.88,"text":"They get their bags and coats."},{"start":180.22,"end":181.34,"text":"Now it is time to go home."},{"start":182.38,"end":184.06,"text":"The school day ends in the afternoon."},{"start":184.88,"end":188.46,"text":"Children go home on the yellow bus, walk with a parent or go by car."},{"start":189.02,"end":190.72,"text":"They say bye to their teacher and friends."},{"start":192.2,"end":193.5,"text":"Children are hungry after school."},{"start":194.08,"end":195.56,"text":"At home, they eat a snack."},{"start":196.26,"end":198.24,"text":"A snack is a little food between meals."},{"start":198.6,"end":200.98,"text":"It can be an apple, cheese or a cookie."},{"start":200.98,"end":202.78,"text":"They drink water or milk."},{"start":203.82,"end":204.88,"text":"Then it is time for homework."},{"start":205.68,"end":207.5,"text":"Homework is school work at home."},{"start":207.5,"end":210.82,"text":"Children read a little book or answer math questions."},{"start":211.24,"end":212.12,"text":"A parent can help."},{"start":213,"end":214.66,"text":"Children put their books away when they finish."},{"start":215.52,"end":217.04,"text":"After that, there is time to play."},{"start":217.78,"end":219.14,"text":"Children go outside with friends."},{"start":219.72,"end":221.14,"text":"They ride bikes and play ball."},{"start":221.54,"end":223.32,"text":"They play in the yard or at the park."},{"start":223.94,"end":225.94,"text":"A yard is the grass next to a house."},{"start":226.66,"end":229.3,"text":"Children can do activities after school too."},{"start":229.7,"end":231.88,"text":"They play soccer, basketball or baseball."},{"start":232.56,"end":234.18,"text":"They go to music or art class."},{"start":234.76,"end":237.78,"text":"They can join a club with other children who like the same things."},{"start":238.38,"end":240.9,"text":"An after-school program is a place to go after class."},{"start":241.64,"end":243.7,"text":"Children get help with reading and math there."},{"start":244.08,"end":245.06,"text":"They play games too."},{"start":245.72,"end":250.3,"text":"After school is also a time to see grandparents, brothers, sisters and friends."},{"start":251.04,"end":253,"text":"In the evening, the family eats dinner."},{"start":253.48,"end":256.82,"text":"Dinner can be chicken, rice or soup with vegetables."},{"start":256.82,"end":260.22,"text":"Children sit at the table and talk about their day."},{"start":260.9,"end":263.34,"text":"They talk about school, friends and games."},{"start":263.34,"end":265.22,"text":"Children help at home too."},{"start":265.76,"end":267.42,"text":"They put things on the table for dinner."},{"start":268.14,"end":269.86,"text":"After dinner, they help clean the table."},{"start":270.38,"end":272.3,"text":"They give food to the dog or the cat."},{"start":273.08,"end":274.04,"text":"Then there is free time."},{"start":274.7,"end":277.56,"text":"Children play with toys, draw or watch TV."},{"start":278.3,"end":279.68,"text":"They can play video games too."},{"start":280.4,"end":281.94,"text":"Before bed, children wash."},{"start":282.44,"end":284.12,"text":"They take a bath or a shower."},{"start":284.56,"end":286.14,"text":"They put on clean clothes for bed."},{"start":286.74,"end":288.28,"text":"Then they brush their teeth again."},{"start":288.96,"end":290.18,"text":"A parent reads a story."},{"start":291.24,"end":294.08,"text":"Children listen in bed and look at the pictures in the book."},{"start":295.06,"end":297.34,"text":"Then they say good night."},{"start":297.34,"end":298.58,"text":"The lights go off."},{"start":299.78,"end":300.9,"text":"It is time to sleep."},{"start":302.02,"end":303.78,"text":"On the weekend, there is no school."},{"start":303.78,"end":305.86,"text":"Children can sleep a little longer."},{"start":306.36,"end":308.82,"text":"They play, see family and go to sports games."}],"words":[{"text":"It","start":0,"end":0.14},{"text":"is","start":0.14,"end":0.28},{"text":"seven","start":0.28,"end":0.52},{"text":"o'clock","start":0.52,"end":0.86},{"text":"in","start":0.86,"end":0.98},{"text":"the","start":0.98,"end":1.08},{"text":"morning","start":1.08,"end":1.36},{"text":"A","start":1.72,"end":1.84},{"text":"clock","start":1.84,"end":2.06},{"text":"rings","start":2.06,"end":2.54},{"text":"Children","start":3.32,"end":3.44},{"text":"wake","start":3.44,"end":3.74},{"text":"up","start":3.74,"end":3.98},{"