age","start":37.04,"end":37.3},{"text":"sticker","start":37.3,"end":37.64},{"text":"and","start":37.64,"end":38.08},{"text":"wears","start":38.08,"end":38.28},{"text":"it","start":38.28,"end":38.44},{"text":"on","start":38.44,"end":38.56},{"text":"their","start":38.56,"end":38.72},{"text":"shirt","start":38.72,"end":38.98},{"text":"Write","start":39.7,"end":39.84},{"text":"your","start":39.84,"end":40.04},{"text":"languages","start":40.04,"end":40.36},{"text":"on","start":40.36,"end":40.7},{"text":"two","start":40.7,"end":40.96},{"text":"lines","start":40.96,"end":41.42},{"text":"so","start":41.42,"end":41.96},{"text":"people","start":41.96,"end":42.16},{"text":"can","start":42.16,"end":42.38},{"text":"see","start":42.38,"end":42.54},{"text":"the","start":42.54,"end":42.66},{"text":"difference","start":42.66,"end":42.96},{"text":"Your","start":43.82,"end":43.96},{"text":"native","start":43.96,"end":44.22},{"text":"language","start":44.22,"end":44.66},{"text":"is","start":44.66,"end":44.98},{"text":"the","start":44.98,"end":45.12},{"text":"first","start":45.12,"end":45.32},{"text":"language","start":45.32,"end":45.64},{"text":"you","start":45.64,"end":45.84},{"text":"learned","start":45.84,"end":46.04},{"text":"as","start":46.04,"end":46.24},{"text":"a","start":46.24,"end":46.34},{"text":"child","start":46.34,"end":46.66},{"text":"It","start":47.08,"end":47.2},{"text":"goes","start":47.2,"end":47.34},{"text":"on","start":47.34,"end":47.56},{"text":"the","start":47.56,"end":47.68},{"text":"Speak","start":47.68,"end":47.9},{"text":"line","start":47.9,"end":48.22},{"text":"For","start":48.66,"end":48.76},{"text":"example","start":48.76,"end":49.3},{"text":"Speak","start":50.92,"end":51.14},{"text":"Japanese","start":51.14,"end":52.26},{"text":"Practise","start":52.26,"end":54.92},{"text":"English","start":54.92,"end":55.42},{"text":"A","start":55.42,"end":56.76},{"text":"sticker","start":56.76,"end":57.1},{"text":"shows","start":57.1,"end":57.56},{"text":"you","start":5