","start":60.08,"end":60.5},{"text":"grasshoppers","start":60.5,"end":61.3},{"text":"being","start":61.3,"end":61.54},{"text":"eaten","start":61.54,"end":62},{"text":"Anticuchos","start":62.82,"end":63.38},{"text":"are","start":63.38,"end":63.62},{"text":"popular","start":63.62,"end":64.14},{"text":"and","start":64.14,"end":64.48},{"text":"inexpensive","start":64.48,"end":65.08},{"text":"meat","start":65.08,"end":65.6},{"text":"skewers","start":65.6,"end":66.14},{"text":"from","start":66.14,"end":66.36},{"text":"the","start":66.36,"end":66.52},{"text":"Andes","start":66.52,"end":66.78},{"text":"mountains","start":66.78,"end":67.18},{"text":"especially","start":67.56,"end":67.94},{"text":"Peru","start":67.94,"end":68.34},{"text":"and","start":68.86,"end":68.98},{"text":"you","start":68.98,"end":69.06},{"text":"can","start":69.06,"end":69.18},{"text":"also","start":69.18,"end":69.38},{"text":"find","start":69.38,"end":69.7},{"text":"them","start":69.7,"end":69.86},{"text":"in","start":69.86,"end":70.04},{"text":"Bolivia","start":70.04,"end":70.3},{"text":"Chile","start":70.86,"end":70.96},{"text":"and","start":71.26,"end":71.36},{"text":"Ecuador","start":71.36,"end":71.72},{"text":"The","start":72.6,"end":72.72},{"text":"surprise","start":72.72,"end":73.08},{"text":"here","start":73.08,"end":73.36},{"text":"is","start":73.36,"end":73.52},{"text":"not","start":73.52,"end":73.72},{"text":"the","start":73.72,"end":73.86},{"text":"cooking","start":73.86,"end":74.12},{"text":"but","start":74.38,"end":74.5},{"text":"the","start":74.5,"end":74.64},{"text":"cut","start":74.64,"end":74.76},{"text":"of","start":74.76,"end":74.9},{"text":"meat","start":74.9,"end":75.14},{"text":"The","start":75.92,"end":76.08},{"text":"most","start":76.08,"end":76.28},{"text":"popular","start":76.28,"end":76.7},{"text":"version","start":76.7,"end":77.04},{"text":"anticuchos","start":77.36,"end":78.02},{"text":"de","start":78.02,"end":78.2},{"text":"corazon","start":78.2,"end":78.7},{"text":"uses