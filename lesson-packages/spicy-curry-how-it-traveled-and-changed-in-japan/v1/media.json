","start":27.84,"end":28.2},{"text":"three","start":28.2,"end":28.52},{"text":"ideas","start":28.52,"end":29.04},{"text":"source","start":29.04,"end":29.82},{"text":"change","start":30.22,"end":30.56},{"text":"and","start":30.98,"end":31.1},{"text":"result","start":31.1,"end":31.5},{"text":"The","start":31.5,"end":32.34},{"text":"source","start":32.34,"end":32.64},{"text":"is","start":32.64,"end":32.98},{"text":"an","start":32.98,"end":33.14},{"text":"earlier","start":33.14,"end":33.44},{"text":"food","start":33.44,"end":33.8},{"text":"tradition","start":33.8,"end":34.28},{"text":"Change","start":35,"end":35.2},{"text":"happens","start":35.2,"end":35.6},{"text":"when","start":35.6,"end":35.9},{"text":"cooks","start":35.9,"end":36.28},{"text":"meet","start":36.28,"end":36.52},{"text":"new","start":36.52,"end":36.8},{"text":"ingredients","start":36.8,"end":37.32},{"text":"needs","start":37.7,"end":38.04},{"text":"or","start":38.26,"end":38.44},{"text":"tastes","start":38.44,"end":38.76},{"text":"The","start":39.5,"end":39.7},{"text":"result","start":39.7,"end":40.06},{"text":"is","start":40.06,"end":40.38},{"text":"a","start":40.38,"end":40.52},{"text":"new","start":40.52,"end":40.72},{"text":"style","start":40.72,"end":41.14},{"text":"that","start":41.14,"end":41.6},{"text":"has","start":41.6,"end":41.82},{"text":"its","start":41.82,"end":42.02},{"text":"own","start":42.02,"end":42.22},{"text":"identity","start":42.22,"end":42.76},{"text":"British","start":43.98,"end":44.22},{"text":"colonial","start":44.22,"end":44.66},{"text":"contact","start":44.66,"end":45.38},{"text":"with","start":45.38,"end":45.74},{"text":"South","start":45.74,"end":46.02},{"text":"Asia","start":46.02,"end":46.38},{"text":"introduced","start":46.78,"end":47.5},{"text":"British","start":47.5,"end":47.94},{"text":"people","start":47.94,"end":48.4},{"text":"to","start":48.4,"end":48.66},{"text":"many","start":48.66,"end":48.94},{"text":"spiced","start":48.94,"end":49.32},{"text":"dishes","start"