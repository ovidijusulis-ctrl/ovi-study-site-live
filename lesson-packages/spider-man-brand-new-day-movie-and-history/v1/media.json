{"audio":{"src":"https://pub-13abeb101e2945d2a7f60234f6faf52e.r2.dev/materials/spider-man-brand-new-day-movie-and-history/audio/main-a707a2a6501b.mp3","durationSec":94.584,"cues":[{"start":0,"end":4.62,"text":"Spider-Man first appeared in Amazing Fantasy 15 in August 1962."},{"start":5.8,"end":8.44,"text":"Stan Lee wrote the stories and Steve Ditko drew them."},{"start":9.3,"end":12.86,"text":"In the story, a student named Peter Parker visits a science exhibit."},{"start":13.4,"end":15.38,"text":"A radioactive spider bites him."},{"start":15.88,"end":18.84,"text":"After the bite, Peter gains super powers."},{"start":18.84,"end":20,"text":"He invents web shooters."},{"start":20.66,"end":24.28,"text":"He puts on a costume and becomes Spider-Man."},{"start":24.28,"end":27.2,"text":"In Spider-Man: Brand New Day, something big changes."},{"start":27.2,"end":29.62,"text":"The whole world forgets Peter Parker."},{"start":30.12,"end":31.8,"text":"His old friends do not remember him."},{"start":32.24,"end":33.42,"text":"They move on with their lives."},{"start":34.16,"end":34.8,"text":"Peter is alone."},{"start":35.32,"end":36.32,"text":"But he does not stop."},{"start":36.88,"end":39,"text":"He works as Spider-Man full-time."},{"start":39,"end":40.18,"text":"He still saves people."},{"start":40.76,"end":44.18,"text":"Even without anyone knowing his name, he keeps choosing to help."},{"start":44.94,"end":47.84,"text":"Seeing his old friends move on creates pressure for Peter."},{"start":48.4,"end":49.78,"text":"This starts a change in him."},{"start":50.32,"end":52.38,"text":"Peter may not be able to control that change."},{"start":52.7,"end":57.54,"text":"But that transformation may help stop a new threat to the city and the people he loves."},{"start":58.54,"end":60.02,"text":"Peter also faces a new threat."},{"start":60.7,"end":62.84,"text":"The villain in Brand New Day cannot be seen."},{"start":63.42,"end":65.5,"text":"This makes the danger very hard to face."},{"start":66.28,"end":70.88,"text":"A threat that cannot be seen is a serious danger to the city and the people Peter loves."},{"start":70.88,"end":74.52,"text":"Spider-Man: Brand New Day is a Sony Pictures movie."},{"start":75.02,"end":77.56,"text":"It opens on July 31, 2026."},{"start":78.74,"end":80.64,"text":"The world does not remember Peter Parker."},{"start":81.32,"end":83.1,"text":"He works as Spider-Man full-time."},{"start":83.1,"end":85.82,"text":"He faces a villain no one can see."},{"start":86.48,"end":89.88,"text":"A change begins inside him that he may not be able to control."},{"start":90.86,"end":93.98,"text":"Peter still chooses to help the city and the people he loves."}],"words":[{"text":"Spider-Man","start":0,"end":0.58},{"text":"first","start":0.58,"end":0.82},{"text":"appeared","start":0.82,"end":1.22},{"text":"in","start":1.22,"end":1.48},{"text":"Amazing","start":1.48,"end":1.8},{"text":"Fantasy","start":1.8,"end":2.26},{"text":"15","start":2.26,"end":2.84},{"text":"in","start":2.84,"end":3.4},{"text":"August","start":3.4,"end":3.72},{"text":"1962","start":3.72,"end":4.62},{"text":"Stan","start":5.8,"end":5.84},{"text":"Lee","start":5.84,"end":6.06},{"text":"wrote","start":6.06,"end":6.28},{"text":"the","start":6.28,"end":6.46},{"text":"stories","start":6.46,"end":6.82},{"text":"and","start":7.12,"end":7.16},{"text":"Steve","start":7.16,"end":7.5},{"text":"Ditko","start":7.5,"end":7.82},{"text":"drew","start":7.82,"end":8.14},{"text":"them","start":8.14,"end":8.44},{"text":"In","start":9.3,"end":9.52},{"text":"the","start":9.52,"end":9.64},{"text":"story","start":9.64,"end":10.02},{"text":"a","start":10.22,"end":10.36},{"text":"student","start":10.36,"end":10.62},{"text":"named","start":10.62,"end":10.92},{"text":"Peter","start":10.92,"end":11.22},{"text":"Parker","start":11.22,"end":11.56},{"text":"visits","start":11.56,"end":11.92},{"text":"a","start":11.92,"end":12.14},{"text":"science","start":12.14,"end":12.44},{"text":"exhibit","start":12.44,"e